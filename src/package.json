{
	"name": "banada-bot",
	"version": "2.0.0",
	"private": true,
	"description": "Banada Bot - discord.js v14 + DisTube v5 music bot",
	"main": "index.js",
	"scripts": {
		"start": "node index.js",
		"deploy": "node deployCommands.js",
		"check": "node scripts/check.js",
		"test": "node --test \"tests/**/*.test.js\" \"features/**/*.test.js\"",
		"deploy:reset": "node deployCommands.js --reset",
		"docs:commands": "node scripts/command-docs.js"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"dependencies": {
		"@discordjs/opus": "0.11.0",
		"@discordjs/voice": "0.19.2",
		"@distube/soundcloud": "2.0.4",
		"@distube/spotify": "2.0.2",
		"@distube/youtube": "1.1.0",
		"chalk": "^4.1.2",
		"discord.js": "14.28.1",
		"distube": "5.2.3",
		"ffmpeg-static": "5.3.0"
	}
}
